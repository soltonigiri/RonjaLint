{
  "name": "textlint-rule-ronjalint",
  "version": "0.1.0",
  "description": "A textlint rule and AI agent style pack for Japanese Logical Gohou.",
  "keywords": [
    "textlint",
    "textlintrule",
    "japanese",
    "writing-style"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "ronjalint-agent": "./scripts/install-agent.mjs"
  },
  "files": [
    ".agents/hooks/",
    ".agents/skills/ronjalint/",
    ".codex/hooks.json",
    "examples/",
    "grammar/",
    "lib/",
    "README.md",
    "scripts/",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "test": "npm run generate:check && npm run build && tsx --test test/index-test.ts && node --test test/hook-test.mjs test/spec-test.mjs test/install-test.mjs",
    "prepare": "npm run generate:check && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "textlint": ">=15.8.0"
  },
  "dependencies": {
    "emoji-regex": "^10.6.0",
    "textlint-rule-helper": "^2.5.0"
  },
  "devDependencies": {
    "@textlint/kernel": "^15.8.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@textlint/types": "^15.8.0",
    "@types/node": "^20.19.43",
    "textlint": "^15.8.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
